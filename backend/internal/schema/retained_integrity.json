  "constraints": {
    "activity_messages": ["FOREIGN KEY (activity_id) REFERENCES activities(id) ON DELETE CASCADE"],
    "api_key_permissions": ["FOREIGN KEY (api_key_id) REFERENCES api_keys(id) ON DELETE CASCADE", "FOREIGN KEY (environment_id) REFERENCES environments(id) ON DELETE CASCADE"],
    "api_keys": ["FOREIGN KEY (environment_id) REFERENCES environments(id) ON DELETE CASCADE", "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"],
    "environments": ["FOREIGN KEY (api_key_id) REFERENCES api_keys(id) ON DELETE SET NULL"],
    "project_tags": ["CHECK ((color IN ('gray', 'purple', 'blue', 'green', 'yellow', 'orange', 'red', 'pink')))", "CHECK ((source IN ('ui', 'compose')))", "FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE"],
    "projects": ["UNIQUE (dir_name)"],
    "roles": ["UNIQUE (name)"],
    "user_avatars": ["FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"],
    "user_role_assignments": ["FOREIGN KEY (environment_id) REFERENCES environments(id) ON DELETE CASCADE", "FOREIGN KEY (role_id) REFERENCES roles(id) ON DELETE CASCADE", "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"],
    "user_sessions": ["FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE", "UNIQUE (refresh_token_hash)"],
    "users": ["CHECK ((time_format IN ('auto', '12h', '24h')))", "UNIQUE (username)"],
    "vulnerability_scan_items": ["FOREIGN KEY (image_id) REFERENCES vulnerability_scans(id) ON DELETE CASCADE", "CHECK (details IS NULL OR json_valid(details))"],
    "webhooks": ["UNIQUE (token_hash)"],
    "activities": ["CHECK (status IN ('queued','running','success','failed','cancelled'))", "CHECK ((COALESCE(gate_scope, '') = '') = (COALESCE(gate_key, '') = ''))"],
    "vulnerability_reports": ["CHECK (data IS NULL OR json_valid(data))"],
    "system_backup_runs": ["CHECK (size BETWEEN 0 AND 2147483648)", "CHECK (archive_name IS NULL OR (length(archive_name) BETWEEN 5 AND 132 AND archive_name NOT GLOB '*[^A-Za-z0-9_.-]*' AND substr(archive_name,-4) = '.tar'))", "CHECK (archive_version IS NULL OR archive_version = 1)", "CHECK (migration_version IS NULL OR migration_version >= 1)", "CHECK (copy_state IN ('none','pending','succeeded','failed'))"],
    "system_backup_policies": ["CHECK (retention_count >= 1)"]
  },
  "indexes": [
    "CREATE INDEX idx_activities_environment_batch ON activities (environment_id, batch_id);",
    "CREATE INDEX idx_activities_environment_started ON activities (environment_id, started_at);",
    "CREATE INDEX idx_activities_environment_status_updated ON activities (environment_id, status, updated_at);",
    "CREATE INDEX idx_activities_resource ON activities (resource_type, resource_id);",
    "CREATE INDEX idx_activity_messages_activity_created ON activity_messages (activity_id, created_at);",
