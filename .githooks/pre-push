set -eu
cd "$(git rev-parse --show-toplevel)"
# Scratch Git repositories must not inherit the parent hook's repository selection.
for variable in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$variable"
done
node scripts/pre-push.mjs
