# Hub address, database and listener.
APP_URL=http://127.0.0.1:3552
DATABASE_URL=postgres://docklet:change-me@127.0.0.1:5432/docklet
PORT=3552
ACTOR_PORT=3551
LISTEN=127.0.0.1
ENVIRONMENT=production
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUSTED_PROXIES=

# Authentication and encryption. Supply real secret values at deployment.
# JWT_SECRET is deprecated; use ENCRYPTION_KEY for new deployments.
ALLOW_CLI_PASSWORD_RESET=false
JWT_SECRET=
JWT_SECRET_FILE=
JWT_SECRET__FILE=
JWT_REFRESH_EXPIRY=168h
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=
ENCRYPTION_KEY__FILE=
ADMIN_STATIC_API_KEY=
ADMIN_STATIC_API_KEY_FILE=
ADMIN_STATIC_API_KEY__FILE=

# Host, Docker and project workspace.
PUID=
PGID=
# DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_CONFIG=
# PROJECTS_DIRECTORY=/app/data/projects
PROJECT_SCAN_MAX_DEPTH=3
PROJECT_SCAN_SKIP_DIRS=.git,node_modules,vendor,.venv,venv,__pycache__,.cache,dist,build,target,.next,.nuxt
PROJECT_WORKSPACE_MAX_DEPTH=20
PROJECT_WORKSPACE_MAX_ENTRIES=2000
PROJECT_WORKSPACE_MAX_FILE_SIZE_MB=10
VOLUME_WORKSPACE_MAX_DEPTH=50
VOLUME_WORKSPACE_MAX_ENTRIES=10000
VOLUME_WORKSPACE_MAX_FILE_SIZE_MB=10
FILE_PERM=0644
DIR_PERM=0755
ARCANE_BACKUP_VOLUME_NAME=arcane-backups
SSH_KNOWN_HOSTS=

# Logging, HTTP clients and proxy configuration.
LOG_JSON=false
LOG_LEVEL=info
# HTTP_CLIENT_TIMEOUT=0
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
TZ=UTC

# Agent and edge connection.
AGENT_MODE=false
AGENT_TOKEN=
AGENT_TOKEN_FILE=
AGENT_TOKEN__FILE=
MANAGER_API_URL=https://hub.example.com
EDGE_AGENT=false
EDGE_TRANSPORT=auto
EDGE_RECONNECT_INTERVAL=5
EDGE_MTLS_MODE=disabled
EDGE_MTLS_CA_FILE=
EDGE_MTLS_CERT_FILE=
EDGE_MTLS_KEY_FILE=
EDGE_MTLS_SERVER_NAME=
EDGE_MTLS_ASSETS_DIR=

# Optional runtime features and maintenance.
UPDATE_CHECK_DISABLED=false
UI_CONFIGURATION_DISABLED=false
GPU_MONITORING_ENABLED=false
GPU_TYPE=auto
ARCANE_IN_CONTAINER=false
container=
ARCANE_UPGRADE_KEEP_CONTAINER=false

# Optional settings values. Uncomment only the values you intend to set.
# envOverride keys work in normal mode; other settings keys are honoured only with
# either AGENT_MODE or UI_CONFIGURATION_DISABLED set to true.

