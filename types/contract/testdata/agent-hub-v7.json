    "retainedStatus": 200,
    "fields": ["activityId","code","activity"],
    "completion": false
  },
  "conflicts": ["run.busy","run.cancelling","run.request-mismatch"],
  "limits": {
    "deliveryMinutes": 30,
    "admissionMinutes": 5,
    "clientRetryMinutes": 10,
    "compactRetentionHours": 24,
    "negativeEvidenceMinutes": 60,
    "querySeconds": 5,
    "bodyBytes": 1048576,
    "outputBytes": 262144
  },
  "recovery": {
    "globalAdministrator": true,
    "activityReadAndCancel": true,
    "reasonAndAcknowledgment": true,
    "stoppedExecutorAndCheckedDocker": true,
