{
  "name": "docklet-next",
  "version": "0.0.0",
  "private": true,
  "description": "Docklet Next repository foundation",
  "license": "Apache-2.0 AND BSD-3-Clause",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "lint": "node scripts/run-checks.mjs lint",
    "test": "node scripts/run-checks.mjs test",
    "build": "node scripts/run-checks.mjs build",
    "contract:generate": "node scripts/openapi-contract.mjs generate",
    "contract:check": "node scripts/openapi-contract.mjs check",
    "check:publication": "node scripts/check-publication.mjs --worktree --history",
    "check:structure": "node scripts/check-structure.mjs",
    "check:pr": "node scripts/check-pr-publication.mjs",
    "check:review": "node scripts/review-status.mjs",
    "test:text": "node scripts/change-scope.mjs --run-text-tests"
  }
}
